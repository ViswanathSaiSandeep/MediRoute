# MediRoute Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# In CI, set these as GitHub Repository Secrets / Environment Variables.

# Deployment URL for E2E tests (must be live GitHub Pages — never localhost)
BASE_URL=https://ViswanathSaiSandeep.github.io/MediRoute/

# Google Gemini AI (Flutter build: --dart-define=GEMINI_API_KEY=...)
GEMINI_API_KEY=

# Google Maps API (Flutter build: --dart-define=GOOGLE_MAPS_API_KEY=...)
GOOGLE_MAPS_API_KEY=

# Firebase (replace placeholders in firebase_options.dart via build script or dart-define)
FIREBASE_API_KEY_WEB=
FIREBASE_API_KEY_ANDROID=

# Selenium settings
HEADLESS=true
BROWSER=chrome
EXPLICIT_WAIT=20

# Appium settings
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
DEVICE_NAME=emulator-5554
APP_PACKAGE=com.mediroute.app
APP_ACTIVITY=.MainActivity
PLATFORM_VERSION=14
